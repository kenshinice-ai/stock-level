# Copy to agent/.env and fill in.

# Model to watch: iphoneduo | iphone18promax | iphone18pro
FAMILY=iphoneduo

# Stores: all, a state (VIC), store ids (R180,R343) or store names, comma separated.
STORES=VIC

# Optional filters (empty = any): 256gb,512gb,1tb,2tb / nightsky,starwhite
CAPS=
COLORS=

# Seconds between checks (minimum 15). Each check is 1 request per state watched.
INTERVAL_SEC=30

# Telegram alerts (see agent/README.md). Several chat ids can be comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# macOS: speak the alert out loud (0 to disable)
SAY=1
